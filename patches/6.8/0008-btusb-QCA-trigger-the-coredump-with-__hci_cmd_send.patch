From b2032bd3d705d259da04348f5406b92ffafcfdae Mon Sep 17 00:00:00 2001
From: hhsnake <hhsnakeg@gmail.com>
Date: Sun, 4 Oct 2026 17:28:08 +0300
Subject: [PATCH 08/10] btusb: QCA: trigger the coredump with __hci_cmd_send()

Backport of mainline b23d98d46d28 ("Bluetooth: btusb: Fix triggering
coredump implementation for QCA"): the vendor command that makes the
firmware dump has no completion event, so __hci_cmd_sync() always timed
out.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/bluetooth/btusb.c | 9 ++++-----
 1 file changed, 4 insertions(+), 5 deletions(-)

diff --git a/drivers/bluetooth/btusb.c b/drivers/bluetooth/btusb.c
index 54b4cc6..dde95fd 100644
--- a/drivers/bluetooth/btusb.c
+++ b/drivers/bluetooth/btusb.c
@@ -3465,13 +3465,12 @@ static void btusb_dump_hdr_qca(struct hci_dev *hdev, struct sk_buff *skb)
 
 static void btusb_coredump_qca(struct hci_dev *hdev)
 {
+	int err;
 	static const u8 param[] = { 0x26 };
-	struct sk_buff *skb;
 
-	skb = __hci_cmd_sync(hdev, 0xfc0c, 1, param, HCI_CMD_TIMEOUT);
-	if (IS_ERR(skb))
-		bt_dev_err(hdev, "%s: triggle crash failed (%ld)", __func__, PTR_ERR(skb));
-	kfree_skb(skb);
+	err = __hci_cmd_send(hdev, 0xfc0c, 1, param);
+	if (err < 0)
+		bt_dev_err(hdev, "%s: triggle crash failed (%d)", __func__, err);
 }
 
 /* Return: 0 on success, negative errno on failure. */
